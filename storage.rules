rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Avatares: solo el usuario autenticado puede subir/leer su propio avatar
    match /avatares/{userId}.jpg {
      allow read: if true; // Lectura pública para que se vea en todos los dispositivos
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Denegar todo lo demás
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
